   "source": [
    "import pandas as pd\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    \"city\" : [\"Hyd\", \"Delhi\", \"Mumbai\"]\n",
    "})\n",
    "\n",
    "df[\"city_encoded\"] = df[\"city\"].astype(\"category\").cat.codes\n",
    "\n",
    "print(df)"
   ]
  },
